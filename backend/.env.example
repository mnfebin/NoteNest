# NoteNest Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notenest?schema=public"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_notenest_college_project_change_in_production
JWT_EXPIRES_IN=7d

# Supabase Storage Configuration (for PDF lecture notes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=notes

# File Upload Limit
MAX_FILE_SIZE_MB=10
