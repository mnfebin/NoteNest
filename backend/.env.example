# NoteNest Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 1. PostgreSQL Database Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:mypassword@localhost:5432/notenest?schema=public
DATABASE_URL="your_postgresql_connection_string"

# 2. JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_at_least_16_characters_long
JWT_EXPIRES_IN=7d

# 3. Supabase Storage Configuration (for persistent PDF lecture notes)
# Obtain these from your Supabase Project Settings -> API and Storage
SUPABASE_URL="your_supabase_project_url"
SUPABASE_SERVICE_ROLE_KEY="your_server_side_service_role_key"
SUPABASE_STORAGE_BUCKET="notenest-notes"

# 4. File Upload Limits
MAX_FILE_SIZE_MB=10

# 5. Offline / Local Fallback (Optional for testing without live Supabase)
# Set to true only if you want uploads stored on local disk during development
ALLOW_LOCAL_STORAGE=false

